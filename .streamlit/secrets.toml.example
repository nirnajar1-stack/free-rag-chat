# Copy to secrets.toml for local Streamlit, or paste into
# Streamlit Cloud → App settings → Secrets / HF Spaces → Settings → Secrets

GROQ_API_KEY = "your_groq_api_key_here"
DOCS_FOLDER_PATH = "data/docs"

# Google Drive cloud — see SETUP_GOOGLE_DRIVE.md
GOOGLE_DRIVE_FOLDER_ID = "your_folder_id_here"
# Paste the service account JSON as a string, or use a TOML table with the same fields.
GOOGLE_SERVICE_ACCOUNT_JSON = """{"type":"service_account","project_id":"..."}"""
