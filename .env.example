# Free Groq API key — create one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Local docs folder (fallback / cache for Drive sync)
DOCS_FOLDER_PATH=data/docs

# --- Google Drive cloud (no desktop install) ---
# See SETUP_GOOGLE_DRIVE.md
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json
# Or paste the full JSON in one line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional overrides
# GROQ_MODEL_NAME=llama-3.3-70b-versatile
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVER_K=4
