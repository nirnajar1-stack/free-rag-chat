# Free Groq API key — create one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Folder containing your documents (PDF, TXT, Markdown).
# Examples:
#   Google Drive for desktop (Windows): G:/My Drive/RAG_Docs
#   Google Drive for desktop (macOS):   /Users/you/Library/CloudStorage/GoogleDrive-you@email/My Drive/RAG_Docs
#   Local folder:                       data/docs
#
# When this path is outside the project (e.g. Google Drive), ChromaDB is stored at:
#   {DOCS_FOLDER_PATH}/.rag_vectorstore
DOCS_FOLDER_PATH=data/docs

# Optional explicit Chroma path (overrides the Drive/.rag_vectorstore default)
# VECTORSTORE_PATH=G:/My Drive/RAG_Docs/.rag_vectorstore

# Optional overrides
# GROQ_MODEL_NAME=llama-3.3-70b-versatile
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVER_K=4
